# ==============================================================================
# Dakshan AI - Environment Configuration Example
# Groq Cloud API Setup (Ultra-fast LPU inference)
# ==============================================================================

# Paste your Groq API key from https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Conversational temperature (0.7 for natural, articulate dialogue)
LLM_TEMPERATURE=0.7
LLM_TIMEOUT_MS=45000
