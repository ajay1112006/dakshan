# ==============================================================================
# Dakshan AI - Environment Configuration Example
# Pure Google Gemini API Setup
# ==============================================================================

# Paste your Gemini API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Conversational temperature (0.7 for natural, articulate dialogue)
LLM_TEMPERATURE=0.7
LLM_TIMEOUT_MS=45000
