# ==============================================================================
# Dakshan AI - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Option 1: Google Gemini API (Recommended for Cloud / Vercel / Instant AI)
# ------------------------------------------------------------------------------
# Get your free API key at: https://aistudio.google.com/app/apikey
# When GEMINI_API_KEY is set, Dakshan AI automatically uses Google Gemini.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# Option 2: Local GGUF / OpenAI-Compatible Server (Used if GEMINI_API_KEY is empty)
# ------------------------------------------------------------------------------
# The base URL of your local GGUF inference server:
#   - llama.cpp server (default): http://127.0.0.1:8080/v1
#   - Ollama:                     http://127.0.0.1:11434/v1
#   - LM Studio:                  http://127.0.0.1:1234/v1
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_MODEL=Qwen3-0.6B-Q8_0.gguf
LLM_API_KEY=not-needed

# Model sampling temperature (lower = more deterministic & factual for waste sorting)
LLM_TEMPERATURE=0.2

# Request timeout in milliseconds (default: 30000ms / 30 seconds)
LLM_TIMEOUT_MS=30000

# When true, provides an instant intelligent fallback response if servers are unreachable
ENABLE_OFFLINE_FALLBACK=true
