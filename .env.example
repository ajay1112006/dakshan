# ==============================================================================
# Dakshan AI - Environment Configuration Example
# Copy this file to .env.local and populate your values.
# ==============================================================================

# ------------------------------------------------------------------------------
# Option 1: Google Gemini API (Recommended - Live AI Model)
# ------------------------------------------------------------------------------
# Paste your Gemini API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Conversational temperature (0.7 for natural conversational flow)
LLM_TEMPERATURE=0.7
LLM_TIMEOUT_MS=45000

# ------------------------------------------------------------------------------
# Option 2: Local GGUF / llama.cpp Server (Used if GEMINI_API_KEY is empty)
# ------------------------------------------------------------------------------
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_MODEL=Qwen3-0.6B-Q8_0.gguf
LLM_API_KEY=not-needed

# Set to true only if you want offline canned responses when no LLM is running
ENABLE_OFFLINE_FALLBACK=false
