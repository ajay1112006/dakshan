# ==============================================================================
# Dakshan AI - Environment Configuration
# ==============================================================================

# The base URL of your local GGUF inference server exposing an OpenAI-compatible endpoint.
# Examples:
#   - llama.cpp server (default): http://127.0.0.1:8080/v1
#   - Ollama:                     http://127.0.0.1:11434/v1
#   - LM Studio:                  http://127.0.0.1:1234/v1
#   - LocalAI / vLLM:             http://127.0.0.1:8000/v1
LLM_BASE_URL=http://127.0.0.1:8080/v1

# The model identifier requested by the server.
# For llama.cpp server with one loaded model, 'default' or any string is accepted.
# For Ollama, specify the model tag, e.g., 'mistral', 'llama3.2', 'qwen2.5'.
LLM_MODEL=default

# API key for the inference server. Local servers generally do not require one.
LLM_API_KEY=not-needed

# Model sampling temperature (lower = more deterministic & factual for waste sorting)
LLM_TEMPERATURE=0.2

# Request timeout in milliseconds (default: 30000ms / 30 seconds)
LLM_TIMEOUT_MS=30000

# When true, provides an instant intelligent local fallback response if the GGUF server
# is unreachable, so developers can test the full UI without booting llama-server first.
# Set to 'false' to strictly throw a 503 error if your local server is offline.
ENABLE_OFFLINE_FALLBACK=true
